{
    "Format": "2.3.0",
    "DynamicTokens": [
        // 老鼠谷剧情阶段（后面的条目在条件满足时覆盖前面的）
        // 0 未发现 / 1 废墟山谷 / 2 清理后的老鼠山谷 / 3 重建后的老鼠谷
        // 对话主题 MouseValley_Cleanup、MouseValley_Construction 由事件 31279002、31279005 添加，持续期间阶段不推进
        { "Name": "MouseValleyStage", "Value": "0" },
        { "Name": "MouseValleyStage", "Value": "1", "When": { "HasSeenEvent": "31279001" } },
        { "Name": "MouseValleyStage", "Value": "2", "When": { "HasSeenEvent": "31279002", "HasConversationTopic |contains=MouseValley_Cleanup": "false" } },
        { "Name": "MouseValleyStage", "Value": "3", "When": { "HasSeenEvent": "31279005", "HasConversationTopic |contains=MouseValley_Construction": "false" } },

        // 矿井老鼠洞通向的地图，阶段 0 没有值（不添加传送点）
        { "Name": "MouseValleyMap", "Value": "Custom_MouseValleyRuined", "When": { "MouseValleyStage": "1" } },
        { "Name": "MouseValleyMap", "Value": "Custom_MouseValley", "When": { "MouseValleyStage": "2" } },
        { "Name": "MouseValleyMap", "Value": "Custom_MouseValleyNew", "When": { "MouseValleyStage": "3" } },

        // 老鼠们的生活状态：Hidden 待在客厅不露面 / Valley 住在老鼠山谷 / NewValley 住在重建后的老鼠谷
        // Felix 在 31279003 露面，其余三只在 31279004 露面；31279005 之后施工期间全部回到客厅
        { "Name": "MouseFelixPhase", "Value": "Hidden" },
        { "Name": "MouseFelixPhase", "Value": "Valley", "When": { "MouseValleyStage": "2", "HasSeenEvent |contains=31279003": "true", "HasSeenEvent |contains=31279005": "false" } },
        { "Name": "MouseFelixPhase", "Value": "NewValley", "When": { "MouseValleyStage": "3" } },
        { "Name": "MouseFamilyPhase", "Value": "Hidden" },
        { "Name": "MouseFamilyPhase", "Value": "Valley", "When": { "MouseValleyStage": "2", "HasSeenEvent |contains=31279004": "true", "HasSeenEvent |contains=31279005": "false" } },
        { "Name": "MouseFamilyPhase", "Value": "NewValley", "When": { "MouseValleyStage": "3" } },

        // 施工期（看过 31279005，重建尚未完成）：矿井老鼠洞只显示提示文字，不再传送
        { "Name": "MouseValleyConstruction", "Value": "false" },
        { "Name": "MouseValleyConstruction", "Value": "true", "When": { "MouseValleyStage": "2", "HasSeenEvent |contains=31279005": "true" } },

        // ---- 客厅座位（Custom_MouseLivingRoom）：每只老鼠吃饭、阅读时的专属座位和坐姿帧
        // DineSeat_/ReadSeat_ 是 "X Y 朝向"（0 上 1 右 2 下 3 左），直接写在事件的角色列表里：MouseFelix {{DineSeat_MouseFelix}}
        // DineFrame_/ReadFrame_ 是坐姿帧，入座后用 showFrame MouseFelix {{DineFrame_MouseFelix}}
        // 坐姿帧约定：32-35 餐桌坐姿，24-27 捧书坐姿（各按下、右、上、左）；精灵图画好之前 MouseSitPose 为 false，退回站立帧
        { "Name": "MouseSitPose", "Value": "false" },
        { "Name": "DineSitFrame_Up", "Value": "8" },
        { "Name": "DineSitFrame_Up", "Value": "34", "When": { "MouseSitPose": "true" } },
        { "Name": "DineSitFrame_Right", "Value": "4" },
        { "Name": "DineSitFrame_Right", "Value": "33", "When": { "MouseSitPose": "true" } },
        { "Name": "DineSitFrame_Down", "Value": "0" },
        { "Name": "DineSitFrame_Down", "Value": "32", "When": { "MouseSitPose": "true" } },
        { "Name": "DineSitFrame_Left", "Value": "12" },
        { "Name": "DineSitFrame_Left", "Value": "35", "When": { "MouseSitPose": "true" } },
        { "Name": "ReadSitFrame_Right", "Value": "4" },
        { "Name": "ReadSitFrame_Right", "Value": "25", "When": { "MouseSitPose": "true" } },
        { "Name": "ReadSitFrame_Left", "Value": "12" },
        { "Name": "ReadSitFrame_Left", "Value": "27", "When": { "MouseSitPose": "true" } },
        // 餐厅：长桌坐初始老鼠、玩家和第三代，左小桌 Felix 家的孩子，右小桌 Kerwin 家的孩子
        // 阅读厅：20 个坐垫都面向讲台（朝右），初始老鼠站在最后一排，用站立帧
        { "Name": "DineSeat_MouseFelix", "Value": "24 14 1" }, { "Name": "DineFrame_MouseFelix", "Value": "{{DineSitFrame_Right}}" },
